{
  "name": "@soroswap/aggregator",
  "version": "2.3.0",
  "description": "Soroswap Aggregator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "hardhat test scripts/gas-report.ts --network hardhat",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "deploy:mainnet": "hardhat run scripts/deploy/mainnet.ts --network mainnet",
    "deploy:sepolia": "hardhat run scripts/deploy/sepolia.ts --network sepolia",
    "deploy:base": "hardhat run scripts/deploy/base.ts --network base",
    "deploy:testnet": "hardhat run scripts/deploy/testnet.ts --network sepolia",
    "verify:mainnet": "hardhat verify --network mainnet",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:base": "hardhat verify --network base",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@soroswap/swap-router": "^1.0.0",
    "viem": "^2.9.0",
    "wagmi": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "hardhat": "^2.19.4",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
